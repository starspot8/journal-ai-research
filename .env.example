# Journal AI Research Environment Configuration

# Server
PORT=8080
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL isolated container mapped to port 5435)
DATABASE_URL=postgres://journal_user:journal_password@127.0.0.1:5435/journal_ai_db?sslmode=disable

# Timeouts & Rate Limits
HTTP_TIMEOUT=15s
SEARCH_TIMEOUT=10s
RATE_LIMIT_PER_MINUTE=60

# Optional Scientific Provider API Keys (for higher rate limits)
NCBI_API_KEY=
CROSSREF_MAILTO=research@journal-ai.local
